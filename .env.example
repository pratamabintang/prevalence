# ================================================================
# DINKES DATA TOOLS - ENVIRONMENT VARIABLES TEMPLATE
# Salin file ini menjadi .env dan sesuaikan nilai rahasia di bawah.
# ================================================================

# Port HTTP backend internal (standar: 3000)
PORT=3000

# Path database SQLite dan direktori upload berkas
DB_PATH=data/dinkes.db
UPLOADS_DIR=uploads

# Kredensial Autentikasi Pengelola Data (/data)
DATA_ADMIN_ID=bidangkesmas
DATA_ADMIN_PASSWORD=@Dinkes123#

# Secret Key untuk Signing Session Token HMAC-SHA256
AUTH_SECRET=dinkes-auth-secret-key-2026
